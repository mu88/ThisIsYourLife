<Project>
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Version>6.0.1</Version>
    <!-- BL0016: private home app; JS exceptions intentionally propagate to the caller, no blanket recovery. -->
    <NoWarn>$(NoWarn);BL0016</NoWarn>
    <Features>$(Features);runtime-async=on</Features>
  </PropertyGroup>
</Project>
